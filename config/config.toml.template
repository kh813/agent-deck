# agent-deck configuration template
# Copy this file to config.toml (project root) and fill in your values.
# config.toml is gitignored but read at runtime.

[oauth]
# Google OAuth2 credentials (GCP Console -> APIs & Services -> Credentials)
client_id     = "YOUR_CLIENT_ID.apps.googleusercontent.com"
client_secret = "YOUR_CLIENT_SECRET"
# Optional. Only used by [gws] below to fill in client_secret.json's
# required project_id field -- gws never validates it against Google, so
# any non-empty placeholder works if you don't want to look up the real one.
project_id = ""

[drive]
# Google Drive -- Skill Catalog shared folder (used by the skill-catalog skill)
catalog_folder_id = "YOUR_CATALOG_FOLDER_ID"
catalog_url       = "https://drive.google.com/drive/folders/YOUR_CATALOG_FOLDER_ID"
catalog_file_id   = ""

# Google Drive file ID to back up config.toml/client_secret_*.json/docs/ to
# (see python/scripts/tools/backup_config.py). Leave empty to disable.
config_backup_file_id = ""

# Google Drive file IDs for the config-bundled internal distribution ZIP
# (see python/scripts/tools/package_release.py). Leave empty to disable --
# the script errors out clearly instead of uploading nowhere.
org_release_test_file_id = ""
org_release_prod_file_id = ""

[gws]
# Google Workspace CLI (gws -- https://github.com/googleworkspace/cli; NOT an
# official Google product despite the org name) for agy: Gmail / Drive /
# Calendar / Docs / Sheets from the command line. setup.py auto-installs the
# `gws` binary to app/bin/ and reuses the [oauth] client above as its
# client_secret.json -- no separate credentials needed. See
# docs/admin_guide.md §15 before enabling: the Gmail/Docs/Sheets APIs must be
# enabled on the same GCP project, and you must run `gws auth login` once
# yourself afterward (interactive browser consent -- cannot be automated).
# Leave false to disable (default).
enabled = false

[user]
# Your email address (optional). Used only as an OAuth login_hint pre-fill
# for Drive/Calendar sign-in -- if left unset, those flows still work, you
# just pick your account manually on the sign-in screen.
# email = "firstname.lastname@example.com"

[notifications]
# Google Chat incoming webhook URL, used to deliver results from headless/
# scheduled runs (e.g. a cron job invoking `agy --print`). Leave empty to
# disable — set up with the `notify-chat` skill, which guides you through
# creating a Chat space and issuing the webhook URL.
chat_webhook_url = ""

# [company] is intentionally not declared here. It's an optional overlay a
# wrapping project (e.g. an internal fork) can add to its own config.toml to
# enable company-domain email auto-detection and Salesforce link shortcuts:
#
# [company]
# domain = "example.com"
# portal_url = "https://sites.google.com/example.com/portal/home"
# salesforce_url = "https://your-org.my.salesforce.com/"
