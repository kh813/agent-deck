{
  "$comment": "Claude Code permission rules for agent-deck sessions -- the Claude counterpart of python/config/gemini/policies/agent-ui.toml. setup.py renders this to <project>/.claude/agent-deck-settings.json (replacing ${PROJECT_ROOT_RULE} with the install's absolute path in Claude's //abs/path rule form) and agent_config.json passes it via `claude --settings`. `theme: auto` makes Claude Code pick its light/dark palette from the terminal (xterm.js answers the background-color query; the app also sets COLORFGBG from its current theme) instead of defaulting to dark, which made the selected slash-command suggestion indistinguishable on light themes. Deliberately NOT named .claude/settings.json so it never applies to someone developing agent-deck itself with Claude Code.",
  "theme": "auto",
  "permissions": {
    "allow": [
      "Skill",
      "Bash(python3 python/*)",
      "Bash(python3 -m *)",
      "Bash(python python/*)",
      "Bash(python -m *)",
      "Bash(python3 \"${PROJECT_ROOT_POSIX}/python/*)",
      "Bash(python \"${PROJECT_ROOT_POSIX}/python/*)",
      "Bash(venv/bin/python3 *)",
      "Bash(venv/bin/python *)",
      "Bash(venv\\Scripts\\python *)",
      "Bash(python/scripts/automation/automate.bat *)",
      "Bash(python\\scripts\\automation\\automate.bat *)",
      "Bash(marp *)"
    ],
    "deny": [
      "Edit(${PROJECT_ROOT_RULE}/python/**)",
      "Edit(//etc/**)",
      "Edit(//usr/**)",
      "Edit(//bin/**)",
      "Edit(//sbin/**)",
      "Edit(//opt/**)",
      "Edit(//System/**)",
      "Edit(//Library/**)",
      "Edit(//private/**)",
      "Edit(//var/**)",
      "Edit(//dev/**)",
      "Edit(//Applications/**)",
      "Edit(//c/Windows/**)",
      "Edit(//c/Program Files/**)",
      "Edit(//c/ProgramData/**)",
      "Read(~/.ssh/**)",
      "Edit(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Edit(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Edit(~/.gnupg/**)",
      "Read(~/.kube/**)",
      "Edit(~/.kube/**)",
      "Read(~/.vault/**)",
      "Edit(~/.vault/**)",
      "Read(~/.terraform/**)",
      "Edit(~/.terraform/**)",
      "Read(~/.gemini/**)",
      "Edit(~/.gemini/**)",
      "Read(~/.anthropic/**)",
      "Edit(~/.anthropic/**)",
      "Read(~/.openai/**)",
      "Edit(~/.openai/**)",
      "Read(~/.config/**)",
      "Edit(~/.config/**)",
      "Read(~/.netrc)",
      "Edit(~/.netrc)",
      "Read(~/.npmrc)",
      "Edit(~/.npmrc)",
      "Read(~/.pypirc)",
      "Edit(~/.pypirc)",
      "Read(~/.gitconfig)",
      "Edit(~/.gitconfig)",
      "Read(~/.env)",
      "Edit(~/.env)",
      "Read(~/.envrc)",
      "Edit(~/.envrc)",
      "Read(~/.bashrc)",
      "Edit(~/.bashrc)",
      "Read(~/.bash_profile)",
      "Edit(~/.bash_profile)",
      "Read(~/.zshrc)",
      "Edit(~/.zshrc)",
      "Read(~/.zprofile)",
      "Edit(~/.zprofile)",
      "Read(~/.profile)",
      "Edit(~/.profile)",
      "Read(~/Library/**)",
      "Edit(~/Library/**)",
      "Read(~/AppData/**)",
      "Edit(~/AppData/**)",
      "Edit(~/.claude/**)"
    ]
  }
}
